# Public payload allowlist.
# Everything else in this working tree is local workspace: generated child
# Skills, SkillBank and run state (.dao/), outputs, drafts, and nested child
# repositories. They stay out of Git by default instead of being ignored one
# directory at a time. Keep this list in sync with ALLOWED_ROOT_FILES,
# ALLOWED_TOP_LEVEL, and allowed_layout() in scripts/repository_check.py.
/*
!/.gitignore
!/.github/
!/LICENSE
!/README.md
!/SKILL.md
!/CONTRIBUTING.md
!/SECURITY.md
!/test-prompts.json
!/agents/
!/assets/
!/examples/
!/references/
!/scripts/

# Public directories are flat; nested folders are local workspace.
/assets/*/
/examples/*/
/references/*/
/scripts/*/

# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Temporary files and historical local backups
*.bak
*.bak.*
*.tmp
*.log
